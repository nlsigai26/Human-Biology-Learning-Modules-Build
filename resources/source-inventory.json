  "items": [
    {
      "id": "B001",
      "kind": "outcomes",
      "context": "",
      "label": "",
      "exact": "1.1 recognise cell structures as seen with a light microscope and electron microscope\n(TEM images only), including nucleus, chromosomes, cell membrane, mitochondria,\nendoplasmic reticulum and ribosomes\n1.2 describe the functions of the cell structures:\n• nucleus\n• chromosomes\n• cell membrane\n• mitochondria\n• endoplasmic reticulum\n• ribosomes.",
      "source_element": "9add22b0-fca7-4a67-9ec3-663680c40935"
    },
    {
      "id": "B002",
      "kind": "academic",
      "context": "Cells and organelles",
      "label": "Cells:",
      "exact": "Basic units of living organisms.",
      "source_element": "7bea0828-b36f-4458-9fef-5144cbcb2930"
    },
    {
      "id": "B003",
      "kind": "academic",
      "context": "Cells and organelles",
      "label": "Organelles:",
      "exact": "Structures inside cells with specific functions.",
      "source_element": "83c08b60-e9c9-49b9-859f-d14a84d1e841"
    },
    {
      "id": "B004",
      "kind": "image",
