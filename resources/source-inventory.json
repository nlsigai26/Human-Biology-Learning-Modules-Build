      "source_element": "0df9b4e6-1110-42ca-96e3-3492cbe08fad"
    },
    {
      "id": "B005",
      "kind": "academic",
      "context": "Cytoplasm",
      "label": "Structure:",
      "exact": "Jelly-like material outside the nucleus.",
      "source_element": "38705483-ed16-471d-af94-ff015a6f9871"
    },
    {
      "id": "B006",
      "kind": "academic",
      "context": "Cytoplasm",
      "label": "Structure:",
      "exact": "Contains organelles.",
      "source_element": "635b8fd7-7856-43db-90b4-3daf13ae4679"
    },
    {
      "id": "B007",
      "kind": "academic",
      "context": "Cytoplasm",
      "label": "Function:",
      "exact": "Site of many chemical reactions, including anaerobic respiration.",
      "source_element": "3df882b9-8d08-46a6-a43b-e8c75d6023a9"
    },
    {
      "id": "B008",
      "kind": "academic",
      "context": "Cell surface membrane",
      "label": "Cell surface membrane:",
      "exact": "Structure: partially permeable boundary.",
      "source_element": "baee01ad-e5d0-46ec-a72b-08e88bab4480"
    },
    {
      "id": "B009",
      "kind": "academic",
      "context": "Cell surface membrane",
      "label": "Cell surface membrane:",
      "exact": "Function: controls movement into and out of the cell.",
      "source_element": "224770f9-c637-44b9-919f-d6e87da466c6"
    },
    {
      "id": "B010",
      "kind": "academic",
      "context": "Cell surface membrane",
      "label": "Cell surface membrane:",
      "exact": "Substances cross by diffusion or through transport proteins.",
      "source_element": "d978e639-fa3c-4d63-b1a8-8b3f50fdc4fa"
    },
    {
      "id": "B011",
      "kind": "academic",
      "context": "Cell surface membrane",
      "label": "Cell surface membrane:",
      "exact": "Active transport requires energy.",
      "source_element": "ae7e4ea4-c9bc-4b1e-96d9-efa6b0edd4c2"
    },
    {
      "id": "B012",
      "kind": "academic",
      "context": "Cell surface membrane",
      "label": "Cell surface membrane:",
      "exact": "More of this is covered in Unit 2 — Movement of substances into and out of cells",
      "source_element": "d03770ab-f7ae-486f-9fff-b963ecb52427"
    },
    {
      "id": "B013",
      "kind": "academic",
      "context": "Nucleus and nuclear envelope",
      "label": "Nucleus:",
      "exact": "Contains chromosomes.",
      "source_element": "f9750e8a-8ab3-4d4a-a322-af5332822296"
    },
    {
      "id": "B014",
      "kind": "academic",
      "context": "Nucleus and nuclear envelope",
      "label": "Nucleus:",
      "exact": "Chromosomes contain DNA.",
      "source_element": "7ee476c8-4ad3-4e6f-bcc2-71ce11fcf35b"
    },
    {
      "id": "B015",
      "kind": "academic",
      "context": "Nucleus and nuclear envelope",
      "label": "Nucleus:",
      "exact": "Genes are sections of DNA that code for proteins.",
      "source_element": "e9dd2a4b-9703-4d67-b56b-c21a0ab9f34e"
    },
    {
      "id": "B016",
      "kind": "academic",
      "context": "Nucleus and nuclear envelope",
      "label": "Nucleus:",
      "exact": "Which genes are “switched on” determines which proteins are produced.",
      "source_element": "05aff150-e9a6-4427-88f9-0c745d60dcac"
    },
    {
      "id": "B017",
      "kind": "academic",
      "context": "Nucleus and nuclear envelope",
      "label": "Nucleus:",
      "exact": "Some proteins are enzymes.",
      "source_element": "61417f0b-e761-4f51-80eb-423fd186b904"
    },
    {
      "id": "B018",
      "kind": "academic",
      "context": "Nucleus and nuclear envelope",
      "label": "Nucleus:",
      "exact": "Which enzymes are produced determines which chemical reactions can occur.",
      "source_element": "3db8739e-10e9-4186-acb9-91d2754b860a"
    },
    {
      "id": "B019",
      "kind": "academic",
      "context": "Nucleus and nuclear envelope",
      "label": "Nucleus:",
      "exact": "These chemical reactions determine the activity of the cell.",
      "source_element": "a32d09e4-7ed1-45c6-a65f-fc63ea0484b9"
    },
    {
      "id": "B020",
      "kind": "academic",
      "context": "Nucleus and nuclear envelope",
      "label": "Nucleus:",
      "exact": "Thus, the nucleus controls cell activities by controlling which proteins are made.",
      "source_element": "8d0cf206-91ba-4189-b2fa-2b4ed77baec3"
    },
    {
      "id": "B021",
      "kind": "academic",
      "context": "Nucleus and nuclear envelope",
      "label": "Nuclear envelope:",
      "exact": "Separates the nucleus from the cytoplasm.",
      "source_element": "d75e865e-d306-49a5-b556-3d5df699fa0a"
    },
    {
      "id": "B022",
      "kind": "academic",
      "context": "Nucleus and nuclear envelope",
      "label": "Nuclear envelope:",
      "exact": "Contains nuclear pores.",
      "source_element": "58d8f81e-efe6-488d-a6e2-c14eacba8c8d"
    },
    {
      "id": "B023",
      "kind": "academic",
      "context": "Nucleus and nuclear envelope",
      "label": "Nuclear envelope:",
      "exact": "Regulate passage of substances, including mRNA.",
      "source_element": "4adeac21-aceb-416d-93df-45bed0fa13e4"
    },
    {
      "id": "B024",
      "kind": "academic",
      "context": "Nucleus and nuclear envelope",
      "label": "Chromosomes:",
      "exact": "Contain DNA wrapped around proteins called histones.",
      "source_element": "ac418189-4283-42d9-94f9-37d707973121"
    },
    {
      "id": "B025",
      "kind": "academic",
      "context": "Nucleus and nuclear envelope",
      "label": "Chromosomes:",
      "exact": "The DNA contains genes that code for proteins.",
      "source_element": "56bcb9d1-b699-4cbd-a353-a41ab15348d2"
    },
    {
      "id": "B026",
      "kind": "academic",
      "context": "Nucleus and nuclear envelope",
      "label": "Chromosomes:",
      "exact": "We’ll look at chromosome structure in greater detail in the Genes, Chromosomes & DNA section.",
      "source_element": "198d61ed-9249-4d15-8754-32c4f2837632"
    },
    {
      "id": "B027",
      "kind": "academic",
      "context": "Mitochondria",
      "label": "Function:",
      "exact": "Site of most stages of aerobic respiration.",
      "source_element": "9b373642-a14b-4dd9-b033-75cca6e93b58"
    },
    {
      "id": "B028",
      "kind": "academic",
      "context": "Mitochondria",
      "label": "Function:",
      "exact": "Transfer energy into ATP.",
      "source_element": "e884103b-8cb5-47a2-afeb-1e51f56172cb"
    },
    {
      "id": "B029",
      "kind": "academic",
      "context": "Mitochondria",
      "label": "Structure:",
      "exact": "Double membrane.",
      "source_element": "f395c930-4988-48ab-9496-4d3c76a6f47b"
    },
    {
      "id": "B030",
      "kind": "supporting",
      "context": "Mitochondria",
      "label": "Structure:",
      "exact": "Example — high energy demand",
      "source_element": "17994e2a-1094-4a12-a607-e0a1235966b1"
    },
    {
      "id": "B031",
      "kind": "academic",
      "context": "Mitochondria",
      "label": "Structure:",
      "exact": "Muscle cells and sperm cells contain many mitochondria to supply ATP for contraction or movement.",
      "source_element": "ac8ad5b3-9e96-44ee-810a-3086615e75c5"
    },
    {
      "id": "B032",
      "kind": "academic",
      "context": "Endoplasmic reticulum and ribosomes",
      "label": "Endoplasmic reticulum (ER):",
      "exact": "Membrane network of channels and flattened sacs.",
      "source_element": "dc3e0aca-1f0c-4175-a1b7-329ea2cf307b"
    },
    {
      "id": "B033",
      "kind": "academic",
      "context": "Endoplasmic reticulum and ribosomes",
      "label": "Ribosomes:",
      "exact": "Site of translation.",
      "source_element": "30ee6465-184a-4a34-afd8-715b80838d9e"
    },
    {
      "id": "B034",
      "kind": "academic",
      "context": "Endoplasmic reticulum and ribosomes",
      "label": "Ribosomes:",
